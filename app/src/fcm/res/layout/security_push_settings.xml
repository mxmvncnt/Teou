<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Material3.CardView.Elevated"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fcm_relay_title"
            android:textAppearance="?attr/textAppearanceTitleMediumEmphasized" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/fcmRelayUrlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/fcm_relay_url_label"
            app:helperText="@string/fcm_relay_url_help"
            app:placeholderText="@string/fcm_relay_url_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFcmRelayUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveFcmRelay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:text="@string/btn_save" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
