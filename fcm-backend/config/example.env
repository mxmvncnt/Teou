# DO NOT MODIFY THIS FILE. COPY IT AND NAME IT SOMETHING ELSE

# Name of the config (displayed as a log at startup)
CONFIG_NAME=dev

PROJECT_NAME=backbone

# debug, info, warn, error, fatal
LOG_LEVEL=debug

SERVER_HOST=localhost
SERVER_PORT=9090
FRONTEND_URL=http://localhost:9090 # URL that the frontend will be calling from

# PostgreSQL configuration.
DB_USER="postgres"
DB_PASS="password"
DB_PORT="5432"
DB_HOST="localhost"
DB_NAME="polyhx-backbone"

# passkey server
PASSKEY_SERVER_URL=http://localhost:9091

# Resend API Key (for sending confirmation emails). Leave blank to disable sending emails to save on the quota
RESEND_API_KEY=

# JWT Signing key. Can be generated with `openssl rand -base64 32`
JWT_SIGNING_KEY=my-secure-key